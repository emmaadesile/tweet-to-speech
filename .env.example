# Speech provider. Without this the app still runs and falls back to the
# browser's built-in voice, which needs no key but sounds noticeably worse.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini-tts.
OPENAI_TTS_MODEL=

# Optional but recommended. With an X API bearer token the app reads posts
# through the official API instead of the undocumented public endpoints.
# Reading posts requires a paid tier; the free tier is write-only.
X_BEARER_TOKEN=
